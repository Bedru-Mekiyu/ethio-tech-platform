          }
        },
        {
          "name": "POST /auth/login",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const d = pm.response.json()?.data;", "if (d?.accessToken) pm.environment.set('accessToken', d.accessToken);", "if (d?.refreshToken) pm.environment.set('refreshToken', d.refreshToken);", "if (d?.user?.id) pm.environment.set('userId', d.user.id);"] }}],
