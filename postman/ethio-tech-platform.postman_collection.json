      "item": [
        {
          "name": "POST /auth/register",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const d = pm.response.json()?.data;", "if (d?.user?.id) pm.environment.set('userId', d.user.id);", "if (d?.user?.id) pm.environment.set('studentId', d.user.id);"] }}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Student One\",\n  \"email\": \"student1@example.com\",\n  \"password\": \"Password123\",\n  \"role\": \"student\",\n  \"gradeLevel\": 10\n}" },
