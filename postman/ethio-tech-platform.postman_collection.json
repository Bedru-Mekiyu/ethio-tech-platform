        { "name": "GET /hubs/attendance/list", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/hubs/attendance/list?hubId={{hubId}}", "host": ["{{baseUrl}}"], "path": ["hubs", "attendance", "list"], "query": [{"key":"hubId","value":"{{hubId}}"}] } } }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        { "name": "GET /dashboard/student", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/dashboard/student", "host": ["{{baseUrl}}"], "path": ["dashboard", "student"] } } },
        { "name": "GET /dashboard/mentor", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/dashboard/mentor", "host": ["{{baseUrl}}"], "path": ["dashboard", "mentor"] } } }
      ]
    },
    {
      "name": "Badges",
      "item": [
        {
          "name": "POST /badges",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const id = pm.response.json()?.data?.badge?._id;", "if (id) pm.environment.set('badgeId', id);"] }}],
          "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"name\": \"Team Player\",\n  \"description\": \"Great collaboration\",\n  \"xpBonus\": 30,\n  \"category\": \"community\"\n}" }, "url": { "raw": "{{baseUrl}}/badges", "host": ["{{baseUrl}}"], "path": ["badges"] } }
        },
        { "name": "GET /badges", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/badges", "host": ["{{baseUrl}}"], "path": ["badges"] } } },
        { "name": "POST /badges/assign", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"badgeId\": \"{{badgeId}}\"\n}" }, "url": { "raw": "{{baseUrl}}/badges/assign", "host": ["{{baseUrl}}"], "path": ["badges", "assign"] } } }
      ]
    },
    {
      "name": "Certificates",
      "item": [
        { "name": "POST /certificates", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "body": { "mode": "raw", "raw": "{\n  \"student\": \"{{studentId}}\",\n  \"track\": \"{{trackId}}\",\n  \"certificateUrl\": \"https://example.com/certificate.pdf\"\n}" }, "url": { "raw": "{{baseUrl}}/certificates", "host": ["{{baseUrl}}"], "path": ["certificates"] } } },
        { "name": "GET /certificates", "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/certificates?student={{studentId}}", "host": ["{{baseUrl}}"], "path": ["certificates"], "query": [{"key":"student","value":"{{studentId}}"}] } } }
      ]
    }
